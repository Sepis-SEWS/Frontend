# Export these variables in your shell; .env is not automatically loaded.
SEWS_MODE=demo
# Required only for SEWS_MODE=api
API_BASE_URL=http://127.0.0.1:8000
API_CONNECT_TIMEOUT=3
API_READ_TIMEOUT=10
# Server-side credential for a restricted prototype deployment; never commit a token.
SEWS_API_TOKEN=
